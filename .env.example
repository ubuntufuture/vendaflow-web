# Etapa UI: nenhuma credencial necessária. Não adicionar tokens de provedores aqui.
# O sandbox não tem API, banco, autenticação, cobrança ou envio de mensagens.
NEXT_TELEMETRY_DISABLED=1
STORYBOOK_DISABLE_TELEMETRY=1
# Backend tem configuração própria: veja venda-api/.env.example.
# Nunca publicar DATABASE_URL, chaves de sessão ou credenciais OIDC via NEXT_PUBLIC_*.
# Frontend cliente tem configuração própria: veja venda-web/.env.example (somente origens server-side).
