# Configuração exclusivamente server-side. Sem NEXT_PUBLIC e sem credenciais OIDC/DB.
# Origins HTTPS reais do ambiente, sem path, query ou credenciais.
VENDA_WEB_ORIGIN=
VENDA_API_INTERNAL_ORIGIN=
# Somente harness local: permite HTTP loopback. Produção deve omitir.
VENDA_WEB_LOCAL_TEST=false
# Desenvolvimento real via scripts/setup-native-local.mjs; somente loopback.
# Não habilitar em produção. Não inicia fixtures nem contorna autorização.
VENDA_WEB_LOCAL_DEVELOPMENT=false
# Backend: API_ORIGIN e APP_ORIGIN devem ser a origem pública acima.
# /v1/auth/login e /v1/auth/callback passam pelo BFF na mesma origem do cookie __Host-.
# Nenhum serviço simulado entra nesta aplicação.
