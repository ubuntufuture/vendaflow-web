# Sem credenciais embutidas. Carregar por ambiente/secret manager do serviço Venda Flow AI.
NODE_ENV=production
# Somente NODE_ENV=development e origens loopback; produção rejeita true.
VENDA_LOCAL_DEVELOPMENT=false
PORT=3201
DATABASE_URL=
DB_TLS=true
DB_CA_PEM=
API_ORIGIN=
APP_ORIGIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Três segredos independentes, cada um com 32 bytes aleatórios codificados em hex.
SESSION_HASH_KEY=
FLOW_ENCRYPTION_KEY=
CSRF_KEY=
SESSION_SECONDS=28800
SESSION_IDLE_SECONDS=1800
OIDC_TIMEOUT_SECONDS=5
# Opcional. Ausente = não conecta a collector nem envia traces.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Somente job de migrations, nunca injetar essas variáveis no processo da API.
MIGRATION_DATABASE_URL=
MIGRATION_CA_PEM=
MIGRATION_EXPECTED_DATABASE=
